# ==========================================
# Gulf & Pakistan Job Pipeline - Environment Template
# Copy this to .env and fill in your actual values
# ==========================================

# Dashboard Authentication
# REQUIRED in production. The app refuses to start on Vercel/Render (or APP_ENV=production)
# without DASHBOARD_SESSION_SECRET. Generate one with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=generate_with_openssl_rand_hex_32
# Bootstrap admin account. If DASHBOARD_PASSWORD is empty, no admin account is created
# and nobody can log in as admin (there is no default password).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here
SESSION_DURATION_HOURS=72
# APP_ENV=production

# Client IP detection for login rate limiting (proxy headers are NOT trusted by default).
# Vercel uses x-real-ip and Render uses the last X-Forwarded-For hop automatically.
# Behind Cloudflare set CLIENT_IP_HEADER=cf-connecting-ip; behind N other trusted proxies set TRUSTED_PROXY_HOPS=N.
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=0

# Test/demo mode ONLY - never enable in production.
# Enables POST /api/test/reset-rate-limit and self-service Pro upgrade / quota reset
# (needed by the Playwright e2e suite and tests/test_backend_integration.py).
# ENABLE_TEST_ENDPOINTS=1

# Email Notifications (Gmail SMTP or SendGrid/Postmark)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_PASSWORD=your_google_app_password
SMTP_RECIPIENT_EMAIL=your_email@gmail.com
